        "note_tweet": {
          "entities": {
            "urls": [
              {
                "display_url": "store.steampowered.com/app/4673900/Su…",
                "end": 2273,
                "expanded_url": "https://store.steampowered.com/app/4673900/SurroundedByBoys/?l=schinese",
                "start": 2250,
                "url": "https://t.co/AgZQlTp8Bc"
              },
              {
                "display_url": "gamersky.com/news/202608/21…",
                "end": 2297,
